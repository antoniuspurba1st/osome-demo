{
  "name": "osome-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-like AWS SAM serverless backend with TypeScript and PostgreSQL",
  "main": "dist/server.js",
"scripts": {
  "dev": "ts-node --files src/server.ts",
  "build": "tsc -p tsconfig.json",
  "start": "sam local start-api",
  "start:local": "ts-node --files src/server.ts",
  "test": "jest --runInBand",
  "test:watch": "jest --watch",
  "typecheck": "tsc --noEmit",
  "sam:build": "sam build",
  "sam:start": "sam local start-api"
},
